# ══════════════════════════════════════════════════════════════════
# NOCTRA — local environment
#
# Loaded by app/core/config.py (pydantic-settings). Every value here
# overrides the default in that file. Keep this file out of version
# control; .env.example is the template that gets shared.
# ══════════════════════════════════════════════════════════════════

# ── Application ───────────────────────────────────────────────────
APP_NAME="NOCTRA Autoworks"

# development | staging | production | test
APP_ENV="development"

# Never enable debug in production — the app refuses to start.
APP_DEBUG="true"

# Signing key for JWTs and signed values. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY="f779bf5b01ac0cf238df7d9c8df11887089b756ac64fb9cb899890082b299f92"

# Absolute base URL. Used in emails and admin links; no trailing slash.
APP_BASE_URL="http://localhost:8000"

APP_TIMEZONE="Asia/Jakarta"

# DEBUG | INFO | WARNING | ERROR
APP_LOG_LEVEL="DEBUG"

# console = human-readable, json = one structured object per line
APP_LOG_FORMAT="console"


# ── Database ──────────────────────────────────────────────────────
POSTGRES_HOST="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="lamberfuck123445"
POSTGRES_DB="NOCTRADB"

# Connection pool: pool_size + max_overflow = peak connections per process.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Log every SQL statement — noisy, development only.
DB_ECHO="false"


# ── Authentication ────────────────────────────────────────────────
# Access token: 480 minutes = 8 hours.
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=30

# Restrict to HMAC algorithms; blocks `alg=none` and RSA-confusion attacks.
JWT_ALGORITHM="HS256"
JWT_ISSUER="noctra-autoworks"

# bcrypt work factor. 12 is a good balance; raise only if login is fast.
BCRYPT_ROUNDS=12


# ── Session & CSRF ────────────────────────────────────────────────
SESSION_COOKIE_NAME="noctra_session"
SESSION_MAX_AGE_SECONDS=28800
SESSION_COOKIE_HTTPONLY="true"

# lax | strict | none — `none` requires SESSION_COOKIE_SECURE=true.
SESSION_COOKIE_SAMESITE="lax"

# Must be true on HTTPS. The app rejects insecure cookies in production.
SESSION_COOKIE_SECURE="false"

CSRF_COOKIE_NAME="noctra_csrf"
CSRF_HEADER_NAME="X-CSRF-Token"
CSRF_TOKEN_BYTES=32


# ── Rate limiting ─────────────────────────────────────────────────
RATE_LIMIT_ENABLED="true"
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_API_PER_MINUTE=300
RATE_LIMIT_PUBLIC_PER_MINUTE=60

# Only enable behind a reverse proxy that strips client-supplied
# X-Forwarded-For and sets its own. Otherwise leave false.
TRUST_PROXY_HEADERS="false"


# ── CORS & trusted hosts ──────────────────────────────────────────
# Comma-separated origins, or * for any. Do not use * with credentials.
CORS_ORIGINS="*"
CORS_ALLOW_CREDENTIALS="false"

# Comma-separated hostnames. Wildcards allowed: *.noctra.local
TRUSTED_HOSTS="localhost,127.0.0.1,*.noctra.local"


# ── Email / SMTP ──────────────────────────────────────────────────
# Keep false in development to log emails instead of sending them.
EMAIL_ENABLED="false"
EMAIL_FROM_NAME="NOCTRA Autoworks"
EMAIL_FROM_ADDRESS="hello@noctra.local"
EMAIL_REPLY_TO=""

SMTP_HOST="localhost"
SMTP_PORT=587
SMTP_USERNAME=""
SMTP_PASSWORD=""
SMTP_USE_STARTTLS="true"
SMTP_USE_SSL="false"
SMTP_TIMEOUT_SECONDS=30

# Retries are exponential with jitter:
# min(base × 2^attempt, max_delay) + up to 30% jitter.
SMTP_MAX_RETRIES=3
SMTP_RETRY_BASE_DELAY=1.0
SMTP_RETRY_MAX_DELAY=30.0


# ── Public contact details ────────────────────────────────────────
# Used in outbound email templates. Leave PUBLIC_WHATSAPP empty to hide it.
PUBLIC_PHONE="+62 812 3456 7890"
PUBLIC_EMAIL="hello@noctra.local"
PUBLIC_ADDRESS="Jl. Contoh No. 123, Jakarta"
PUBLIC_WHATSAPP=""


# ── Media / uploads ───────────────────────────────────────────────
MEDIA_ROOT="media"

# Allowed URL prefixes for locally uploaded files (comma-separated).
MEDIA_URL_PREFIXES="/media/"

# External hosts allowed in photo URLs, e.g. cdn.example.com or *.cdn.example.com.
# Empty rejects every external URL.
MEDIA_ALLOWED_HOSTS=""


# ── Inquiry workflow ──────────────────────────────────────────────
# Record the first contact when an inquiry moves out of NEW.
INQUIRY_TRACK_CONTACT_ON_TRANSITION="true"
