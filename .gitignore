# ══════════════════════════════════════════════════════════════════
# NOCTRA — files that must never be committed
#
# Keep this file specific to the project. `.env.example` is the only
# environment file that belongs in version control.
# ══════════════════════════════════════════════════════════════════

# ── Secrets & local environment ───────────────────────────────────
.env
.env.*
!.env.example

*.pem
*.key
credentials.json
service-account*.json


# ── Python bytecode ───────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*$py.class
*.so
*.pyd


# ── Virtual environments ──────────────────────────────────────────
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/


# ── Packaging & build artifacts ───────────────────────────────────
build/
dist/
*.egg-info/
.eggs/
*.egg
MANIFEST
.pdm.toml


# ── Tests, coverage & type checking ───────────────────────────────
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/
.nox/
.hypothesis/
.mypy_cache/
.pyre/
.pytype/
.ruff_cache/


# ── Local data, uploads & database dumps ──────────────────────────
/media/
/app.bak/
*.db
*.sqlite3
*.sqlite3-journal
*.dump
*.sql
*.sql.gz
backups/


# ── Logs & temporary files ────────────────────────────────────────
*.log
logs/
tmp/
*.tmp
*.bak
*.orig
*.rej


# ── Editors ───────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo


# ── Operating systems ─────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini
desktop.ini
$RECYCLE.BIN/
