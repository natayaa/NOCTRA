# ══════════════════════════════════════════════════════════════════
# NOCTRA — environment for `docker compose`
#
#   make docker-env      # copies this file to .env.docker and fills in
#                        # random APP_SECRET_KEY / POSTGRES_PASSWORD
#   make docker-up       # builds and starts db + app + nginx
#
# The placeholders below are REJECTED by the application's validators,
# so a manual copy without generating secrets fails loudly instead of
# running insecurely. `.env.example` remains the full local reference.
#
# This file is also read by Compose itself (`--env-file`), which is why
# HTTP_PORT lives here. Never commit `.env.docker`.
# ══════════════════════════════════════════════════════════════════

# ── Compose ───────────────────────────────────────────────────────
# Host port for nginx. Change to 80 only if the host port is free.
HTTP_PORT=8080


# ── Application ───────────────────────────────────────────────────
APP_NAME=NOCTRA Autoworks

# `staging` keeps local http://localhost:8080 working. For a public
# HTTPS deployment switch to `production`, set APP_DEBUG=false,
# SESSION_COOKIE_SECURE=true, and APP_BASE_URL to the https origin.
APP_ENV=staging
APP_DEBUG=false

# `make docker-env` replaces this with a random 48-byte value.
APP_SECRET_KEY=change-me

APP_BASE_URL=http://localhost:8080
APP_TIMEZONE=Asia/Jakarta
APP_LOG_LEVEL=INFO
# `json` gives one structured object per line — ideal for `docker logs`
# and log shippers.
APP_LOG_FORMAT=json


# ── Database ──────────────────────────────────────────────────────
# The compose service is named `db`; the password must match the one
# handed to the postgres container (Compose interpolates it from here).
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=noctra
# `make docker-env` replaces this with a random value.
POSTGRES_PASSWORD=postgres
POSTGRES_DB=NOCTRADB

# One app worker ⇒ at most pool_size + max_overflow connections.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_ECHO=false


# ── Runtime behaviour ─────────────────────────────────────────────
# Keep at 1. The overdue sweep scheduler and the rate limiter are
# in-process state; multiple workers would run each sweep N times.
WEB_CONCURRENCY=1

# Entrypoint: wait for PostgreSQL, then `alembic upgrade head`.
RUN_MIGRATIONS=1
# Seed reference data on boot — leave 0 and run it once manually.
RUN_SEED=0

# Only nginx can reach the app container, and nginx overwrites
# X-Forwarded-For with the real peer address.
TRUST_PROXY_HEADERS=true


# ── Session / CSRF ────────────────────────────────────────────────
SESSION_COOKIE_NAME=noctra_session
SESSION_MAX_AGE_SECONDS=28800
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=lax
# Must be true when APP_ENV=production (HTTPS).
SESSION_COOKIE_SECURE=false

CSRF_COOKIE_NAME=noctra_csrf
CSRF_HEADER_NAME=X-CSRF-Token
CSRF_TOKEN_BYTES=32


# ── Network ───────────────────────────────────────────────────────
# Adjust when serving a real domain (comma-separated, no spaces).
TRUSTED_HOSTS=localhost,127.0.0.1
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
CORS_ALLOW_CREDENTIALS=false


# ── Rate limits ───────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_API_PER_MINUTE=300
RATE_LIMIT_PUBLIC_PER_MINUTE=60


# ── Email / SMTP ──────────────────────────────────────────────────
# Keep disabled until SMTP credentials are configured; emails are then
# logged to the email log instead of being sent.
EMAIL_ENABLED=false
EMAIL_FROM_NAME=NOCTRA Autoworks
EMAIL_FROM_ADDRESS=hello@noctra.local
EMAIL_REPLY_TO=
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_STARTTLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=30
SMTP_MAX_RETRIES=3
SMTP_RETRY_BASE_DELAY=1.0
SMTP_RETRY_MAX_DELAY=30.0


# ── Public contact details ────────────────────────────────────────
PUBLIC_PHONE=+62 812 3456 7890
PUBLIC_EMAIL=hello@noctra.local
PUBLIC_ADDRESS=Jl. Contoh No. 123, Jakarta
PUBLIC_WHATSAPP=


# ── Media ─────────────────────────────────────────────────────────
# Relative to /app inside the image; backed by the `media_data` volume.
MEDIA_ROOT=media
MEDIA_URL_PREFIXES=/media/
MEDIA_ALLOWED_HOSTS=


# ── Workflow ──────────────────────────────────────────────────────
INQUIRY_TRACK_CONTACT_ON_TRANSITION=true
